{
	"schemaVersion": 1,
	"id": "coordmanager",
	"version": "${version}",
	"name": "Coord Manager",
	"description": "Save, share and teleport to named locations, with waypoints on the locator bar. Server-side: players don't need to install it.",
	"authors": [
		"Panos Nikolakakis"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/coord-manager",
		"sources": "https://github.com/panosnikolakakis/coord-manager",
		"issues": "https://github.com/panosnikolakakis/coord-manager/issues"
	},
	"license": "MIT",
	"icon": "assets/coordmanager/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.panosnikolakakis.coordmanager.CoordManager"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
